    <!-- Help items -->
    <string name="help_search_title">Vyhledávání médií</string>
    <string name="help_search_desc">Zadejte název videa nebo skladby do vyhledávacího pole a klepněte na tlačítko Lupa. Výsledky z YouTube se zobrazí v přehledném seznamu.</string>
    <string name="help_eq_title">Ekvalizér a Zvukové Efekty</string>
    <string name="help_eq_desc">5-pásmový hardwarový ekvalizér s předvolbami (Rock, Pop, Jazz, Basy...), funkcí Bass Boost pro hluboké basy a Zesilovačem hlasitosti (Loudness Enhancer), který dokáže znatelně zesílit tichá YouTube videa a hudbu.</string>
    <string name="help_github_title">Stažení z GitHubu</string>
    <string name="help_github_desc">Zdrojové kódy a připravené balíčky APK (app-release.apk) můžete stáhnout z repozitáře na adrese github.com/PatrikKM/Multiprehravac. Kód lze klonovat pomocí \'git clone\' nebo stáhnout jako ZIP archiv.</string>
    <string name="help_voice_title">Autonomní Hlasový Agent</string>
    <string name="help_voice_desc">Klepnutím na ikonu mikrofónu 🎙️ ve vyhledávacím poli můžete dávat hlasové příkazy v češtině (např. \'Přehrát Santana\', \'Další\', \'Pauza\', \'Stáhnout\', \'Kvalita 1080p\', \'Ukončit\'). Agent příkaz automaticky vyhodnotí a vykoná.</string>
    <string name="help_playlist_title">Automatické přehrávání (Playlist)</string>
    <string name="help_playlist_desc">Při vyhledání a spuštění skladby se z výsledků vyhledávání vytvoří playlist. Po skončení jedné skladby přehrávače automaticky pokračuje na další. K dispozici jsou tlačítka \'Předchozí\' (⏮) a \'Další\' (⏭).</string>
    <string name="help_subs_title">Volba titulků</string>
    <string name="help_subs_desc">U videí s dostupnými titulky klepněte na tlačítko \'Titulky\' nebo zvolte jazyk titulků v nabídce ozubeného kola (např. Čeština, Angličtina) nebo je vypněte.</string>
    <string name="help_cast_title">Odeslání na TV a sdílení</string>
    <string name="help_cast_desc">Klepnutím na tlačítko \'Odeslat\' můžete přehrávané video přenést do aplikace YouTube na vaší Smart TV, streamovat přes Chromecast / Smart View nebo sdílet odkaz.</string>
    <string name="help_history_title">Historie přehrávání</string>
    <string name="help_history_desc">Klepnutím na ikonu \'Historie\' v horní liště zobrazíte nedávno přehrávané položky. Klepnutím na jakoukoliv položku ji okamžitě znovu přehrajete.</string>
    <string name="help_local_title">Lokální soubory</string>
    <string name="help_local_desc">Klepnutím na tlačítko \'Otevřít\' vyberete libovolný audio nebo video soubor uložený v paměti telefonu.</string>
    <string name="help_download_title">Stahování audia a videa</string>
    <string name="help_download_desc">Zadejte URL adresu a zvolte \'Stáhnout\'. Můžete vybrat stahování celého videa (MP4) nebo pouze zvukové stopy (MP3). Soubor se uloží do složky Stažené soubory (Downloads).</string>
    <string name="help_fullscreen_title">Celoobrazovkový režim</string>
    <string name="help_fullscreen_desc">Během přehrávání přepněte do celoobrazovkového režimu. K dispozici jsou funkce pro titulky, přepínání skladeb, otáčení obrazovky a úpravu poměru stran.</string>
    <string name="help_bg_title">Přehrávání na pozadí</string>
    <string name="help_bg_desc">Přehrávač běží jako služba na popředí. Zvuk hraje i po zhasnutí obrazovky nebo při přepnutí do jiné aplikace.</string>
    <string name="help_quit_title">Ukončení přehrávače</string>
    <string name="help_quit_desc">Klepnutím na červené tlačítko Vypnout v pravém horním rohu okamžitě zastavíte přehrávání na pozadí, uvolníte paměť, ukončíte službu a zavřete aplikaci.</string>

</resources>