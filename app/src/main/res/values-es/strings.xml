    <!-- Help items -->
    <string name="help_search_title">Búsqueda de medios</string>
    <string name="help_search_desc">Escribe el nombre de un video o canción en el cuadro de búsqueda y pulsa el botón de la Lupa. Los resultados de YouTube aparecerán en una lista clara.</string>
    <string name="help_eq_title">Ecualizador y efectos de audio</string>
    <string name="help_eq_desc">Ecualizador de hardware de 5 bandas con preajustes (Rock, Pop, Jazz, Graves...), Bass Boost para graves profundos y Loudness Enhancer para amplificar videos y música con volumen bajo.</string>
    <string name="help_github_title">Descargar desde GitHub</string>
    <string name="help_github_desc">Puedes descargar el código fuente y los paquetes APK preparados (app-release.apk) desde el repositorio en github.com/PatrikKM/Multiprehravac.</string>
    <string name="help_voice_title">Agente de voz autónomo</string>
    <string name="help_voice_desc">Pulsa el icono del micrófono 🎙️ en el cuadro de búsqueda para dar comandos de voz en español (ej. \'Reproducir Santana\', \'Siguiente\', \'Pausa\', \'Descargar\', \'Calidad 1080p\', \'Salir\').</string>
    <string name="help_playlist_title">Reproducción automática (Lista)</string>
    <string name="help_playlist_desc">Al buscar y reproducir una canción, se crea una lista con los resultados. Al terminar una canción, el reproductor pasa automáticamente a la siguiente. Hay botones \'Anterior\' (⏮) y \'Siguiente\' (⏭).</string>
    <string name="help_subs_title">Selección de subtítulos</string>
    <string name="help_subs_desc">En videos con subtítulos disponibles, pulsa el botón \'Subtítulos\' o elige el idioma en el menú de ajustes, o desactívalos.</string>
    <string name="help_cast_title">Transmitir a TV y compartir</string>
    <string name="help_cast_desc">Al pulsar el botón \'Transmitir\', puedes enviar el video a la app de YouTube en tu Smart TV, transmitir por Chromecast / Smart View o compartir el enlace.</string>
    <string name="help_history_title">Historial de reproducción</string>
    <string name="help_history_desc">Pulsa el icono de \'Historial\' en la barra superior para ver los elementos reproducidos recientemente. Pulsa cualquiera para reproducirlo al instante.</string>
    <string name="help_local_title">Archivos locales</string>
    <string name="help_local_desc">Pulsa el botón \'Abrir\' para seleccionar cualquier archivo de audio o video guardado en la memoria de tu teléfono.</string>
    <string name="help_download_title">Descarga de audio y video</string>
    <string name="help_download_desc">Introduce la URL y elige \'Descargar\'. Puedes descargar el video completo (MP4) o solo la pista de audio (MP3). El archivo se guardará en la carpeta Descargas.</string>
    <string name="help_fullscreen_title">Modo pantalla completa</string>
    <string name="help_fullscreen_desc">Cambia a pantalla completa durante la reproducción. Están disponibles funciones para subtítulos, cambio de pista, rotación de pantalla y ajuste de relación de aspecto.</string>
    <string name="help_bg_title">Reproducción en segundo plano</string>
    <string name="help_bg_desc">El reproductor funciona como un servicio en primer plano. El audio sigue sonando incluso con la pantalla apagada o al cambiar a otra aplicación.</string>
    <string name="help_quit_title">Cerrar reproductor</string>
    <string name="help_quit_desc">Pulsa el botón rojo de encendido en la esquina superior derecha para detener al instante la reproducción en segundo plano, liberar memoria y cerrar la aplicación.</string>

