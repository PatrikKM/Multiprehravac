    <!-- Help items -->
    <string name="help_search_title">Media Search</string>
    <string name="help_search_desc">Enter the name of a video or song in the search box and tap the Magnifying Glass button. YouTube results will appear in a clear list.</string>
    <string name="help_eq_title">Equalizer and Audio Effects</string>
    <string name="help_eq_desc">5-band hardware equalizer with presets (Rock, Pop, Jazz, Bass...), Bass Boost for deep bass, and Loudness Enhancer, which can significantly amplify quiet YouTube videos and music.</string>
    <string name="help_github_title">Download from GitHub</string>
    <string name="help_github_desc">You can download source codes and prepared APK packages (app-release.apk) from the repository at github.com/PatrikKM/Multiprehravac. You can clone the code using \'git clone\' or download it as a ZIP archive.</string>
    <string name="help_voice_title">Autonomous Voice Agent</string>
    <string name="help_voice_desc">Tap the microphone 🎙️ icon in the search box to give voice commands in English (e.g. \'Play Santana\', \'Next\', \'Pause\', \'Download\', \'Quality 1080p\', \'Quit\'). The agent automatically evaluates and executes the command.</string>
    <string name="help_playlist_title">Autoplay (Playlist)</string>
    <string name="help_playlist_desc">When you search and play a song, a playlist is created from the search results. After one song finishes, the player automatically continues to the next one. \'Previous\' (⏮) and \'Next\' (⏭) buttons are available.</string>
    <string name="help_subs_title">Subtitles Selection</string>
    <string name="help_subs_desc">For videos with available subtitles, tap the \'Subtitles\' button or choose the subtitle language in the gear menu (e.g. English) or turn them off.</string>
    <string name="help_cast_title">Cast to TV and Sharing</string>
    <string name="help_cast_desc">By tapping the \'Cast\' button, you can cast the playing video to the YouTube app on your Smart TV, stream via Chromecast / Smart View, or share the link.</string>
    <string name="help_history_title">Playback History</string>
    <string name="help_history_desc">Tap the \'History\' icon in the top bar to view recently played items. Tap any item to instantly play it again.</string>
    <string name="help_local_title">Local Files</string>
    <string name="help_local_desc">Tap the \'Open\' button to select any audio or video file stored in your phone\'s memory.</string>
    <string name="help_download_title">Audio and Video Downloading</string>
    <string name="help_download_desc">Enter the URL and choose \'Download\'. You can choose to download the entire video (MP4) or just the audio track (MP3). The file will be saved in the Downloads folder.</string>
    <string name="help_fullscreen_title">Fullscreen Mode</string>
    <string name="help_fullscreen_desc">Switch to fullscreen mode during playback. Features for subtitles, track switching, screen rotation, and aspect ratio adjustment are available.</string>
    <string name="help_bg_title">Background Playback</string>
    <string name="help_bg_desc">The player runs as a foreground service. Audio plays even when the screen is off or when switching to another app.</string>
    <string name="help_quit_title">Quit Player</string>
    <string name="help_quit_desc">Tap the red Power button in the top right corner to instantly stop background playback, free memory, terminate the service, and close the application.</string>

